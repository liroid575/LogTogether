{
  "name": "logtogether",
  "version": "0.11.7",
  "private": true,
  "type": "module",
  "description": "Privacy-first bilingual family exercise tracker PWA",
  "scripts": {
    "build": "bash scripts/build.sh",
    "serve": "python3 -m http.server 4173 -d dist",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:security": "firebase emulators:exec --only firestore \"node --test tests/security/*.test.mjs\"",
    "emulators": "firebase emulators:start --only firestore",
    "deploy:preview": "firebase hosting:channel:deploy preview",
    "deploy": "firebase deploy --only hosting,firestore:rules,firestore:indexes,functions --force",
    "clean:legacy": "bash scripts/cleanup-legacy-snapshots.sh"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.0",
    "typescript": "7.0.2"
  }
}
